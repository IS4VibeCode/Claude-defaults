{
  "permissions": {
    "deny": [
      "Read(/.vs/**)"
    ]
  }
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "source ~/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "source ~/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "source ~/.claude/hooks/bell.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_ENV": "$HOME/.claude/hooks/init.sh",
    "MIMALLOC_PURGE_DELAY": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "disableRemoteControl": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowNestedUserNamespaces": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        ".vs"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.nuget.org"
      ]
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Processing"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "verbose": true
}
